# کپی کن به .env.local روی سرور (قبل از npm run build)
# cp env.server.example .env.local

# آدرس API بک‌اند (سفارش، سبد، پرداخت، ذخیره محصول)
# در production با docker-compose.production.yml API روی پورت 80 است (نه 8080)
NEXT_PUBLIC_API_URL=http://107.161.175.45/api

# آدرس اسکرپر پایتون (جستجوی مستقیم فرانت → پایتون، طبق IMPLEMENTATION_GUIDE)
# بدون /api در انتها. مثال: http://107.161.175.45:5000
NEXT_PUBLIC_SCRAPER_URL=http://107.161.175.45:5000

# اختیاری: آدرس سایت برای metadata
# NEXT_PUBLIC_SITE_URL=https://micrls.com
