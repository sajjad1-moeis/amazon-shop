# ========== تنظیمات لوکال (تست روی ماشین خودت) ==========
# برای استقرار روی سرور بعداً این مقادیر را عوض کن.

# آدرس API بک‌اند (لوکال)
NEXT_PUBLIC_API_URL=http://localhost:7892/api

# اسکرپر پایتون روی سرور — جستجو همیشه به همین آدرس زده می‌شود (لوکال یا پروداکشن)
NEXT_PUBLIC_SCRAPER_URL=http://107.161.175.45:5000
# مسیر داخلی/سروری برای API ادمین اسکرپر (اگر خالی باشد از NEXT_PUBLIC_SCRAPER_URL استفاده می‌شود)
SCRAPER_SERVICE_URL=http://107.161.175.45:5000
# کلید ادمین اسکرپر (باید دقیقاً با ADMIN_API_KEY همان سرویس اسکرپر یکی باشد)
# اگر این مقدار غلط باشد خطای 401 می‌گیرید؛ اگر خالی باشد خطای server_misconfigured
SCRAPER_ADMIN_API_KEY=efe364bc0c406ccaffd731057c2755101e6ae115c49cdb03e092928a4487ec31

# ---------- NextAuth و ورود با گوگل ----------
